# Langzeit-Caching fuer statische Dateien (LiteSpeed / Apache)
# HTML bleibt immer frisch, versionierte CSS/JS lange cachebar, Bilder moderat.

<IfModule mod_expires.c>
  ExpiresActive On

  # CSS/JS sind ueber ?v= versioniert -> lange cachebar
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType application/x-javascript  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"

  # Schriftarten aendern sich praktisch nie
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType application/font-woff     "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType application/x-font-ttf    "access plus 1 year"

  # Bilder und Medien: moderat, damit Austausch unter gleichem Namen durchkommt
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/gif                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 month"
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType video/webm                "access plus 1 month"
  ExpiresByType application/pdf           "access plus 1 month"

  # HTML immer frisch halten
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Versionierte Assets (CSS/JS) und Schriftarten: 1 Jahr, immutable
  <FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder und Medien: 30 Tage
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # PDF: 30 Tage
  <FilesMatch "\.(pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML: nie dauerhaft cachen, immer neu pruefen
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
